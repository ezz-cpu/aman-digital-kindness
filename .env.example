# Optional OpenAI integration. Keep this file private.
# Revoke any key shared in chat. Put a NEW key here, never in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Tobi stays in free mode until its owner enables OpenAI in Tobi Studio.

# Leave these empty to use local SQLite. Hosted PostgreSQL needs all three.
# Render generates APP_SECRET and TOBI_OWNER_CODE once; keep them unchanged.
DATABASE_URL=
APP_SECRET=
TOBI_OWNER_CODE=

{
  "name": "aman-digital-kindness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A bilingual digital safety and cyberbullying awareness website.",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:browser": "node tools/build-scene.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "build:vercel": "npm run build:browser && node tools/build-vercel.mjs",
    "test": "node --test tests/auth.test.js tests/deployment.test.js tests/postgres.test.js tests/serverless.test.js tests/tobi.test.js tests/tobi-connection.test.js tests/tobi-public.test.js tests/seo.test.js",
    "test:tobi": "node tests/tobi-browser.mjs && node tests/tobi-cancel.mjs",
    "test:tobi-ai": "node tests/tobi-connection-browser.mjs",
    "test:tobi-public": "node tests/tobi-public-browser.mjs",
    "test:ui": "node tests/browser.mjs",
    "test:pages": "node tests/pages.mjs",
    "test:a11y": "node tests/accessibility.mjs",
    "test:scene": "node tests/scene.mjs",
    "test:local": "node tests/local-open.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.56.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "three": "^0.169.0"
  }
}
